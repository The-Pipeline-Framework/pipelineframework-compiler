{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tpf:research:polyglot-projection:profiles:1",
  "title": "Closed research artifact shape, not a production execution contract",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profile": {
      "enum": [
        "tpf-polyglot-probe/0",
        "tpf-polyglot-unary-policy/1"
      ]
    },
    "kind": {
      "const": "compiler-projection-probe"
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "inputType": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "outputType": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "transport": {
          "const": "LOCAL"
        },
        "platform": {
          "const": "COMPUTE"
        },
        "execution": {
          "const": "DIRECT"
        }
      },
      "required": [
        "id",
        "inputType",
        "outputType",
        "transport",
        "platform",
        "execution"
      ],
      "additionalProperties": false
    },
    "requiredCapabilities": {
      "const": [
        "pure",
        "linear",
        "unary",
        "local",
        "retry",
        "cancellation",
        "context"
      ]
    },
    "types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "type": {
                  "const": "int32"
                },
                "presence": {
                  "enum": [
                    "REQUIRED",
                    "OPTIONAL"
                  ]
                },
                "nullability": {
                  "enum": [
                    "NON_NULL",
                    "NULLABLE"
                  ]
                }
              },
              "required": [
                "name",
                "type",
                "presence",
                "nullability"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "fields"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "inputType": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "outputType": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "handler": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "retryLimit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "id",
          "inputType",
          "outputType",
          "handler",
          "retryLimit"
        ],
        "additionalProperties": false
      }
    },
    "contextKeys": {
      "const": [
        "executionId",
        "traceId"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "dslSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindingsSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generatorTreeSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "contractsVersion": {
          "const": "26.11.1"
        },
        "dslJarSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semanticModelJarSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "dslSha256",
        "bindingsSha256",
        "generatorTreeSha256",
        "contractsVersion",
        "dslJarSha256",
        "semanticModelJarSha256"
      ],
      "additionalProperties": false
    },
    "policy": {
      "const": {
        "failureMapping": "structured-failure/1",
        "retryOwner": "LOCAL_SHELL",
        "resultMapping": "explicit-value/1",
        "cancellation": "first-accepted-terminal/1",
        "context": "explicit-snapshot/1",
        "recovery": "REJECT",
        "legacyPolicy": "REJECT"
      }
    }
  },
  "required": [
    "schemaVersion",
    "profile",
    "kind",
    "pipeline",
    "requiredCapabilities",
    "types",
    "steps",
    "contextKeys",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "tpf-polyglot-unary-policy/1"
          }
        }
      },
      "then": {
        "required": [
          "policy"
        ],
        "properties": {
          "steps": {
            "minItems": 3,
            "maxItems": 3
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "policy"
          ]
        }
      }
    }
  ]
}
