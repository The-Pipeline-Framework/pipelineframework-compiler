{
  "application": "export const handlerKeys = ['normalize', 'apply', 'finish'] as const;\n",
  "models": "export type Input = Readonly<{ value: number }>;\r\n",
  "cases": [
    { "name": "verified bytes" },
    { "name": "different run", "change": ["run", "id", 123457], "error": "different workflow" },
    { "name": "different event", "change": ["run", "event", "push"], "error": "different workflow" },
    { "name": "different workflow", "change": ["run", "path", ".github/workflows/another.yml"], "error": "different workflow" },
    { "name": "different repository", "change": ["run", "head_repository.full_name", "other/app"], "error": "different workflow" },
    { "name": "different commit", "change": ["run", "head_sha", "another"], "error": "different workflow" },
    { "name": "boolean attempt", "change": ["run", "run_attempt", true], "error": "was retried" },
    { "name": "retried run", "change": ["run", "run_attempt", 2], "error": "was retried" },
    { "name": "unfinished run", "change": ["run", "status", "in_progress"], "error": "has not completed" },
    { "name": "different referenced workflow", "change": ["run", "referenced_workflows.0.path", "another"], "error": "compiler workflow revision" },
    { "name": "different referenced workflow SHA", "change": ["run", "referenced_workflows.0.sha", "another"], "error": "compiler workflow revision" },
    { "name": "boolean receipt schema", "change": ["receipt", "schemaVersion", true], "error": "compiler revision or profile" },
    { "name": "wrong receipt schema", "change": ["receipt", "schemaVersion", 2], "error": "compiler revision or profile" },
    { "name": "wrong receipt profile", "change": ["receipt", "profile", "another/1"], "error": "compiler revision or profile" },
    { "name": "wrong receipt attempt", "change": ["receipt", "run.attempt", "2"], "error": "compiler revision or profile" },
    { "name": "wrong receipt run", "change": ["receipt", "run.id", "456"], "error": "compiler revision or profile" },
    { "name": "wrong receipt compiler", "change": ["receipt", "compiler.sha", "another"], "error": "compiler revision or profile" },
    { "name": "wrong Contracts version", "change": ["receipt", "compiler.contractsVersion", "26.1.1"], "error": "dependency identity" },
    { "name": "missing compiler digest", "change": ["receipt", "compiler.sha256", ""], "error": "dependency identity" },
    { "name": "mutable dependency", "change": ["receipt", "compiler.dependencies.0.artifact", "example-1-SNAPSHOT.jar"], "error": "dependency identity" },
    { "name": "escaping dependency", "change": ["receipt", "compiler.dependencies.0.artifact", "../example-1.jar"], "error": "dependency identity" },
    { "name": "incorrect dependency digest", "change": ["receipt", "compiler.dependencies.0.sha256", "bad"], "error": "dependency identity" },
    { "name": "wrong source hash", "change": ["receipt", "source.inputs.0.sha256", "another"], "error": "committed inputs" },
    { "name": "wrong binding hash", "change": ["receipt", "source.inputs.1.sha256", "another"], "error": "committed inputs" },
    { "name": "wrong project", "change": ["receipt", "source.project", "other"], "error": "committed inputs" },
    { "name": "wrong output digest", "change": ["file", "models.ts", "tampered\n"], "error": "digest mismatch for models.ts" },
    { "name": "extra output", "change": ["file", "extra.ts", "unexpected\n"], "error": "unexpected set of files" },
    { "name": "wrong projection kind", "change": ["projection", "kind", "projection-probe"], "error": "projection does not match" },
    { "name": "boolean projection schema", "change": ["projection", "schemaVersion", true], "error": "projection does not match" },
    { "name": "wrong projection schema", "change": ["projection", "schemaVersion", 2], "error": "projection does not match" },
    { "name": "wrong projection profile", "change": ["projection", "profile", "another/1"], "error": "projection does not match" },
    { "name": "wrong projection DSL provenance", "change": ["projection", "provenance.dslSha256", "another"], "error": "projection does not match" },
    { "name": "wrong projection bindings provenance", "change": ["projection", "provenance.bindingsSha256", "another"], "error": "projection does not match" },
    { "name": "run and receipt disagree", "change": ["run", "conclusion", "failure"], "error": "conclusion disagree" },
    { "name": "conclusion changes on reread", "change": ["latest", "conclusion", "failure"], "error": "conclusion changed during download" },
    { "name": "attempt changes on reread", "change": ["latest", "run_attempt", 2], "error": "was retried" },
    { "name": "explicit Node receipt", "change": ["receipt", "target", "node"] },
    { "name": "Python target on successful Node receipt", "change": ["receipt", "target", "python"], "error": "requested target" },
    { "name": "null target on successful Node receipt", "change": ["receipt", "target", null], "error": "requested target" },
    { "name": "legacy Node failure without target", "workflowFailure": true, "error": "Generation failed" },
    { "name": "Python target on failed Node receipt", "workflowFailure": true, "change": ["receipt", "target", "python"], "error": "requested target" },
    { "name": "null target on failed Node receipt", "workflowFailure": true, "change": ["receipt", "target", null], "error": "requested target" }
  ]
}
